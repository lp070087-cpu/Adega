# ═══════════════════════════════════════════════════════════════════════
# Delivery Platform — variáveis de ambiente
# -----------------------------------------------------------------------
# Copie para `.env` e preencha com valores REAIS.
# O arquivo `.env` NUNCA vai para o Git (ver .gitignore).
# ═══════════════════════════════════════════════════════════════════════

# ── Neon PostgreSQL ────────────────────────────────────────────────────
# DATABASE_URL: conexão POOLED (host com sufixo "-pooler"), usada pela app.
#   postgresql://USUARIO:SENHA@ep-xxxx-pooler.regiao.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# DIRECT_URL: conexão DIRETA (sem pooler), usada pelas migrations do Prisma.
#   postgresql://USUARIO:SENHA@ep-xxxx.regiao.aws.neon.tech/neondb?sslmode=require
DIRECT_URL=

# ── Auth.js ────────────────────────────────────────────────────────────
# Gere com: openssl rand -base64 32
AUTH_SECRET=

# URL pública da aplicação (localhost em dev, domínio em produção).
AUTH_URL=http://localhost:3000

# O NextAuth aceita os dois nomes; mantidos iguais para evitar divergência
# entre ambientes (Vercel injeta NEXTAUTH_URL em alguns fluxos legados).
NEXTAUTH_URL=http://localhost:3000

# ── Criptografia de credenciais de integração ──────────────────────────
# AES-256-GCM. Precisa de pelo menos 32 caracteres.
# Gere com: openssl rand -base64 32
# Enquanto vazio, salvar credencial de integração falha de propósito
# (fail-closed) — nunca gravamos segredo em texto puro.
TOKEN_ENCRYPTION_KEY=

# ── Storage de imagens (logo/banner/produto) ───────────────────────────
# Nesta fase guardamos apenas URL. Estas chaves ficam para quando o
# adapter real for plugado (ver src/lib/storage.ts).
# BLOB_READ_WRITE_TOKEN=
# CLOUDINARY_URL=

# ── Geocodificação (mapa / área de entrega) ─────────────────────────────
# Transforma endereço em coordenadas no CADASTRO (não no cálculo do frete).
# Sem provedor, o botão "Localizar endereço" explica que não está
# configurado — nunca inventamos coordenada. Ver src/lib/maps/geocoding.ts.
#   nominatim → OpenStreetMap (sem chave; uso pontual, não em massa)
#   google    → exige GEOCODING_API_KEY
# GEOCODING_PROVIDER=
# GEOCODING_API_KEY=

# Admin central: ativar somente após migração aprovada e operador inicial autorizado.
# Não é usado para conceder privilégios. A autorização é consultada no banco.
PLATFORM_ADMIN_ENABLED=false

# Política comercial independente, desligada por padrão. Cada contrato também
# precisa de enforceAccess=true. Não interrompe pedidos ou entregas existentes.
PLATFORM_BILLING_ENFORCEMENT_ENABLED=false

# Asaas: somente Sandbox habilitado por esta versão; depende do Admin Central.
# Chaves são cadastradas cifradas no admin, nunca em variáveis NEXT_PUBLIC.
ASAAS_ENABLED=false

# Atendimento oficial: ativação separada, após migração aprovada de três tabelas.
WHATSAPP_ASSISTANT_ENABLED=false
# E-mail transacional de ativação/recuperação do entregador (remetente verificado).
# RESEND_API_KEY=
# MAIL_FROM=
# WHATSAPP_APP_SECRET=
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_GRAPH_VERSION= (versão habilitada na aplicação Meta)
# APP_PUBLIC_URL=https://seu-dominio
# OPENAI_API_KEY=
# ASSISTANT_AI_MODEL= (modelo autorizado pelo operador central)
# ASSISTANT_JOB_TOKEN= (segredo exclusivo do job de processamento)
# Storage persistente gerido pela plataforma; nunca variáveis NEXT_PUBLIC.
# STORAGE_PROVIDER=cloudinary
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
